# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Comma-separated Telegram numeric user IDs with admin/teacher rights.
# Get yours by messaging @userinfobot
ADMIN_IDS=111111111,222222222

# SQLite file location
DB_PATH=./data/rasch.sqlite

# Mini App server (src/webapp-index.js) — a separate process from the bot.
# Port it listens on locally:
MINIAPP_PORT=8788

# Public HTTPS URL it's reachable at once deployed (ngrok, Vercel, a VPS
# behind Caddy/nginx, etc). Required for the bot's "Open Mini App" button —
# Telegram refuses non-HTTPS Mini App URLs. Leave blank during local dev;
# /test then falls back to chat-based answer entry.
MINIAPP_PUBLIC_URL=
